# Example environment variables only.
# Never commit live secrets or production-only URLs to this file.

# App URLs
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_SITE_URL=https://your-domain.example
SITE_URL=https://your-domain.example
NEXT_PUBLIC_SUPPORT_URL=

# Tenant routing
NEXT_PUBLIC_CMS_ROOT_DOMAIN=your-domain.example
NEXT_PUBLIC_STORE_SUBDOMAIN_BASE_DOMAIN=your-domain.example
CMS_ROOT_DOMAIN=your-domain.example
STORE_SUBDOMAIN_BASE_DOMAIN=your-domain.example

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Firebase auth
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Platform billing
PLATFORM_BKASH_IS_LIVE=false
PLATFORM_BKASH_APP_KEY=
PLATFORM_BKASH_APP_SECRET=
PLATFORM_BKASH_USERNAME=
PLATFORM_BKASH_PASSWORD=
BILLING_WEBHOOK_SECRET=

# Supabase Edge Functions
SUPABASE_URL=https://your-project-id.supabase.co
RESEND_API_KEY=your_resend_api_key

# Deferred processing
ORDER_BACKGROUND_JOBS_TRANSPORT=inline
NOTIFICATION_JOBS_TRANSPORT=inline
NOTIFICATION_PROCESSOR_SECRET=shared_notification_processor_secret
CART_RECOVERY_PROCESSOR_SECRET=shared_cart_recovery_processor_secret

# Cloudflare custom domain provisioning
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_API_TOKEN=your_private_cloudflare_api_token
CLOUDFLARE_DOMAIN_ROUTING_KV_NAMESPACE_ID=your_domain_routing_kv_namespace_id
CUSTOM_DOMAIN_CNAME_TARGET=customers.ezcomo.shop
EZCOMO_PROXY_SECRET=shared_worker_proxy_secret

# Storefront product search index
TYPESENSE_PROTOCOL=https
TYPESENSE_HOST=your-typesense-host.example
TYPESENSE_COLLECTION_PRODUCTS=store_products
TYPESENSE_SEARCH_API_KEY=your_typesense_search_key
TYPESENSE_ADMIN_API_KEY=your_typesense_admin_key
STOREFRONT_SEARCH_WEBHOOK_SECRET=shared_search_sync_secret
