{
  "name": "ezcomo-commerce-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev --webpack -H 127.0.0.1 -p 8080",
    "dev:turbopack": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev -H 127.0.0.1 -p 8080",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0 -p ${PORT:-8080}",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "test:watch": "tsx --test --watch \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "test:preview": "playwright test -c playwright.preview.config.ts",
    "validate:env": "tsx scripts/validate-production-env.ts",
    "migrations:drift": "tsx scripts/check-migration-drift.ts",
    "domain-routing-kv:backfill": "tsx scripts/backfill-domain-routing-kv.ts",
    "sync:cms-library": "tsx scripts/sync-cms-library.ts",
    "storefront-search:setup": "tsx scripts/setup-storefront-search.ts",
    "test:db": "npm run test:db:rls && npm run test:db:subscription-jwt && npm run test:db:billing && npm run test:db:billing-consistency && npm run test:db:invite-atomicity",
    "test:db:rls": "node scripts/run-rls-smoke.mjs",
    "test:db:subscription-jwt": "tsx scripts/run-subscription-owner-jwt-smoke.ts",
    "test:db:billing": "tsx scripts/run-billing-route-smoke.ts",
    "test:db:billing-consistency": "node scripts/run-billing-consistency.mjs",
    "test:db:invite-atomicity": "node scripts/run-invite-atomicity-smoke.mjs"
  },
