{
  "version": 2,
  "ignoreCommand": "bash scripts/vercel/ignore-legacy-project-build.sh",
  "functions": {
    "src/app/api/queues/order-background/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "order-background-events",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    },
    "src/app/api/queues/notification-delivery/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "notification-delivery-events",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    }
  }
}
