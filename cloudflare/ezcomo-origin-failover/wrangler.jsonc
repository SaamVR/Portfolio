{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "989794656b19c8e292a184768fbbbb4a",
  "name": "ezcomo-origin-failover",
  "main": "worker.js",
  "compatibility_date": "2026-08-16",
  "observability": {
    "enabled": true
  },
  "vars": {
    "PRIMARY_ORIGIN_HOSTNAME": "ecomcms-xjw4.onrender.com",
    // Set this only to a verified stable fallback origin. Do not guess a
    // deployment hostname; release-aware routing treats an unconfigured
    // fallback as unavailable when EXPECTED_RELEASE_SHA is enabled.
    // "FALLBACK_ORIGIN_HOSTNAME": "verified-production.vercel.app",
    "PLATFORM_DOMAIN": "ezcomo.shop",
    "FAILOVER_TTL_SECONDS": "30",
    "RELEASE_PROBE_TTL_SECONDS": "15",
    // Operator-controlled, non-secret rollout/rollback identity. Enable only
    // after at least one configured origin reports this exact 40-char SHA from
    // /api/health. Leave unset for compatibility behavior during rollout.
    // "EXPECTED_RELEASE_SHA": "0123456789abcdef0123456789abcdef01234567",
    "DEBUG_ORIGIN_HEADER": "0"
  }
}
